{
  "name": "theemeraldexchange",
  "private": true,
  "version": "0.9.0",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "concurrently -n vite,api -c cyan,magenta \"npm:dev:vite\" \"npm:dev:server\"",
    "dev:vite": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:media-mock": "tsx watch server/mocks/mediaCoreMock.ts",
    "build": "tsc -b && vite build && tsc -p server/tsconfig.json",
    "build:spa": "tsc -b && vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "start": "tsx server/index.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:integration": "PW_INTEGRATION=1 playwright test --project=integration",
    "test:e2e:playback": "PW_INTEGRATION=1 playwright test --project=playback-chrome",
    "test:e2e:all": "npm run test:e2e && npm run test:e2e:integration && npm run test:e2e:playback",
    "eval:recs": "vitest run --config vitest.eval.config.ts",
    "build:napi": "npm --prefix crates/emerald-contracts-napi run build",
    "hooks:install": "chmod +x scripts/git-hooks/pre-push && ln -sf ../../scripts/git-hooks/pre-push .git/hooks/pre-push"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.120.0",
    "@emerald/contracts-napi": "file:./crates/emerald-contracts-napi",
    "@hono/node-server": "^2.1.1",
    "@sentry/node": "10.71.0",
    "@sentry/react": "10.71.0",
    "@tanstack/react-query": "^5.102.4",
    "@tanstack/react-virtual": "^3.14.10",
    "better-sqlite3": "13.0.3",
    "dotenv": "^17.4.2",
    "hls.js": "^1.7.1",
    "hono": "^4.13.5",
    "jose": "^6.2.10",
    "mpegts.js": "^1.8.2",
    "node-cron": "^4.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sax": "^1.6.1",
    "three": "^0.185.1",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "26.3.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/sax": "^1.2.7",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "concurrently": "10.0.5",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.60.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "shell-quote": "^1.10.0"
  }
}

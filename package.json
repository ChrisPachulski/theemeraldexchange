{
  "name": "theemeraldexchange",
  "private": true,
  "version": "0.9.0",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "concurrently -n vite,api -c cyan,magenta \"npm:dev:vite\" \"npm:dev:server\"",
    "dev:vite": "vite",
    "dev:server": "cargo run -p gateway --bin eex-gateway",
    "dev:media-mock": "tsx watch tests/dev/mediaCoreMock.ts",
    "build": "tsc -b && vite build",
    "build:spa": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:integration": "PW_INTEGRATION=1 playwright test --project=integration",
    "test:e2e:playback": "PW_INTEGRATION=1 playwright test --project=playback-chrome",
    "test:e2e:all": "npm run test:e2e && npm run test:e2e:integration && npm run test:e2e:playback",
    "hooks:install": "chmod +x scripts/git-hooks/pre-push && ln -sf ../../scripts/git-hooks/pre-push .git/hooks/pre-push"
  },
  "dependencies": {
    "@sentry/react": "10.73.0",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-virtual": "^3.14.20",
    "hls.js": "^1.7.3",
    "mpegts.js": "^1.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "concurrently": "10.0.6",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jose": "^6.2.12",
    "jsdom": "^30.1.3",
    "playwright": "^1.60.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "5.0.5"
  },
  "overrides": {
    "shell-quote": "^1.10.0"
  }
}

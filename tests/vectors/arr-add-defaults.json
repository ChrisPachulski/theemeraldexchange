      ],
      "expected_path": "/data/Media/TV",
      "matched": true
    },
    {
      "name": "case variant",
      "configured": "/DATA/MEDIA/TV",
      "folders": [
        {
          "id": 1,
          "path": "/mnt/scratch/downloads"
        },
        {
          "id": 2,
          "path": "/data/Media/TV"
        }
      ],
      "expected_path": "/data/Media/TV",
      "matched": true
    },
    {

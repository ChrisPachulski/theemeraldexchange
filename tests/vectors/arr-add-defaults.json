    {
      "name": "empty string is unset, not a match for a '' path",
      "configured": "",
      "folders": [
        {
          "id": 1,
          "path": "/movies"
        },
        {
          "id": 2,
          "path": "/other"
        }
      ],
      "expected_path": "/movies",
      "matched": false

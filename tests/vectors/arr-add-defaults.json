        }
      ],
      "expected_path": "/data/media/movies",
      "matched": true
    },
    {
      "name": "trailing slash, live path returned verbatim",
      "configured": "/data/media/tv/",
      "folders": [
        {
          "id": 1,
          "path": "/mnt/scratch/downloads"
        },
        {
          "id": 2,

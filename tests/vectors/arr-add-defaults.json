      "configured": "/data/media/tv///",
      "folders": [
        {
          "id": 1,
          "path": "/mnt/scratch/downloads"
        },
        {
          "id": 2,
          "path": "/data/Media/TV"
        }
      ],
      "expected_path": "/data/Media/TV",
      "matched": true
    },
    {
      "name": "backslash separators",
      "configured": "d:\\media\\tv\\",
      "folders": [
        {
          "id": 3,
          "path": "D:\\Media\\TV"
        }
      ],
      "expected_path": "D:\\Media\\TV",
      "matched": true
    },
    {
      "name": "absent curated path falls back to the first folder",
      "configured": "/data/media/gone",
      "folders": [
        {
          "id": 1,
          "path": "/mnt/scratch/downloads"
        },
        {
          "id": 2,
          "path": "/data/media/movies"
        }
      ],
      "expected_path": "/mnt/scratch/downloads",
      "matched": false
    },
    {
      "name": "unset (null) falls back to the first folder",
